<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme -->
    <style name="Theme.NxshaApp" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/nxsha_red</item>
        <item name="colorPrimaryVariant">@color/nxsha_red_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/nxsha_accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorBackground">@color/background_dark</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorError">@color/error_red</item>
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:navigationBarColor">@color/background_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Immersive fullscreen theme for the player -->
    <style name="Theme.NxshaApp.Player" parent="Theme.NxshaApp">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:keepScreenOn">true</item>
    </style>

    <!-- Transparent bottom sheet dialogs -->
    <style name="Theme.NxshaApp.BottomSheet" parent="Theme.Material3.Dark.BottomSheetDialog">
        <item name="android:windowIsTranslucent">true</item>
        <item name="bottomSheetStyle">@style/Widget.NxshaApp.BottomSheet</item>
    </style>

    <style name="Widget.NxshaApp.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="android:background">@color/surface_elevated</item>
        <item name="shapeAppearance">@style/ShapeAppearance.NxshaApp.BottomSheet</item>
    </style>

    <style name="ShapeAppearance.NxshaApp.BottomSheet" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSizeTopLeft">16dp</item>
        <item name="cornerSizeTopRight">16dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- Search bar style -->
    <style name="Widget.NxshaApp.SearchBar" parent="Widget.Material3.SearchBar">
        <item name="android:background">@color/surface_elevated</item>
    </style>

    <!-- Tab layout style -->
    <style name="Widget.NxshaApp.TabLayout" parent="Widget.Material3.TabLayout">
        <item name="tabIndicatorColor">@color/nxsha_red</item>
        <item name="tabSelectedTextColor">@color/nxsha_red</item>
        <item name="tabTextColor">@color/text_secondary</item>
        <item name="tabBackground">@android:color/transparent</item>
    </style>

</resources>
